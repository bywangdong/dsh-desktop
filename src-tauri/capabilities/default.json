{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "environment"],
  "permissions": [
    "allow-bootstrap",
    "allow-inspect-runtime",
    "allow-prepare-runtime",
    "allow-get-setup-status",
    "allow-cancel-setup",
    "allow-pick-runtime-path",
    "allow-apply-runtime",
    "allow-open-logs",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "opener:default"
  ]
}
